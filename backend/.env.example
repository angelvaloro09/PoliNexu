# Copiar a `.env` (que está en .gitignore) y rellenar.

# Clave Fernet para cifrar las credenciales del SAES en `saes_accounts`.
# Sin ella el login funciona igual, pero no se puede re-autenticar con sólo el
# CAPTCHA (habrá que reescribir boleta y contraseña cada vez).
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Cada cuánto (segundos) el worker hace ping a las sesiones vivas para resetear
# el sliding timeout del SAES. Debe quedar holgadamente por debajo del timeout
# real medido con `scripts/probe_session.py --watch`.
KEEPALIVE_INTERVAL_SECONDS=480

# Sesiones sin uso por más días que esto se purgan y dejan de recibir ping.
SESSION_MAX_IDLE_DAYS=7
